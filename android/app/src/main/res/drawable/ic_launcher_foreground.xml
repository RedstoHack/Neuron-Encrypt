<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: white lock icon on transparent background.
     Canvas is 108x108dp; the lock art is centered within the 72x72dp safe zone
     (from 18,18 to 90,90) so launcher masks (circle, squircle, rounded square)
     never clip the lock. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lock shackle (U-shape on top) -->
    <path
        android:fillColor="#F5F5F5"
        android:fillType="evenOdd"
        android:pathData="M42,52 L42,40 C42,33.4 47.4,28 54,28 C60.6,28 66,33.4 66,40 L66,52 L60,52 L60,40 C60,36.7 57.3,34 54,34 C50.7,34 48,36.7 48,40 L48,52 Z" />

    <!-- Lock body (rounded rectangle) -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M36,50 L72,50 C73.1,50 74,50.9 74,52 L74,80 C74,81.1 73.1,82 72,82 L36,82 C34.9,82 34,81.1 34,80 L34,52 C34,50.9 34.9,50 36,50 Z" />

    <!-- Keyhole circle -->
    <path
        android:fillColor="#6366F1"
        android:pathData="M54,58 C52.3,58 51,59.3 51,61 C51,62.7 52.3,64 54,64 C55.7,64 57,62.7 57,61 C57,59.3 55.7,58 54,58 Z" />

    <!-- Keyhole stem -->
    <path
        android:fillColor="#6366F1"
        android:pathData="M53,63 L55,63 L55.5,72 L52.5,72 Z" />
</vector>
