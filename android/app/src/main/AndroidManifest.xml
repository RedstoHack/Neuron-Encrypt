<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service for long-running crypto operations (keeps the process
         alive when the user backgrounds the app mid-encryption). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Neuron Encrypt"
        android:theme="@style/Theme.NeuronEncrypt"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- .vx2 file handling only — drop the broad application/octet-stream MIME
                 filter so the app isn't offered as the default handler for arbitrary
                 binary downloads. Users can still pick any file from inside the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.vx2" />
            </intent-filter>

        </activity>

        <!-- Foreground service for crypto operations. dataSync type is for
             long-running file processing tasks. -->
        <service
            android:name=".CryptoService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
